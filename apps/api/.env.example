# API - BOJU BOJU Arena
# Copy to .env for local development (no Docker required)
APP_ENV=development
APP_NAME=BOJU BOJU Arena API
APP_HOST=0.0.0.0
APP_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (SQLite default for easy local run; use Postgres in production if desired)
DATABASE_URL=sqlite+aiosqlite:///./boju_dev.db
# DATABASE_URL=postgresql+asyncpg://boju:boju@localhost:5432/boju

# Redis (optional - in-memory fallback is used if unavailable)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-dev-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=bb_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# Production (e.g. Render): REFRESH_COOKIE_SECURE=true, REFRESH_COOKIE_SAMESITE=none, HTTPS required
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email (console in dev)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@boju-boju.local


# LiveKit (Phase 6+ placeholders)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
